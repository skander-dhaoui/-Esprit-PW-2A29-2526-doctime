# ============================================================================
# Configuration OAuth Social Login
# ============================================================================

# Google OAuth
# Obtenir les clés sur: https://console.developers.google.com/
GOOGLE_CLIENT_ID=REPLACE_ME_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_ME_GOOGLE_CLIENT_SECRET

# GitHub OAuth
# Obtenir les clés sur: https://github.com/settings/developers
GITHUB_CLIENT_ID=REPLACE_ME_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_ME_GITHUB_CLIENT_SECRET

# Facebook OAuth
# Obtenir les clés sur: https://developers.facebook.com/apps/
FACEBOOK_CLIENT_ID=REPLACE_ME_FACEBOOK_CLIENT_ID
FACEBOOK_CLIENT_SECRET=REPLACE_ME_FACEBOOK_CLIENT_SECRET

# LinkedIn OAuth
# Obtenir les clés sur: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=REPLACE_ME_LINKEDIN_CLIENT_ID
LINKEDIN_CLIENT_SECRET=REPLACE_ME_LINKEDIN_CLIENT_SECRET
LINKEDIN_SCOPE=profile email openid

# ============================================================================
# Google reCAPTCHA v2 (checkbox « Je ne suis pas un robot »)
# https://www.google.com/recaptcha/admin
# ============================================================================
# En production sans ces clés : fallback captcha texte (pas de case Google).
# En local (localhost / 127.0.0.1) : clés de test Google automatiques si les deux sont vides.
# Pour forcer le captcha texte en local : RECAPTCHA_DISABLE_TEST_KEYS=1
RECAPTCHA_DISABLE_TEST_KEYS=
RECAPTCHA_FORCE_TEST_KEYS=

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ============================================================================
# Base de données
# ============================================================================
DB_HOST=localhost
DB_NAME=doctime_db
DB_USER=root
DB_PASS=

# ============================================================================
# Email Configuration
# ============================================================================
# Gmail : activer la validation en 2 étapes puis créer un « mot de passe d'application »
# https://support.google.com/accounts/answer/185833
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM=your-email@gmail.com
MAIL_FROM_NAME=Valorys
